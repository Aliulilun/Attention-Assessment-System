# =========================
# Ignore everything first
# =========================
*

# =========================
# But allow Git to enter folders
# =========================
!*/

# =========================
# Fully ignore model_test (large data: videos, models),
# except the script itself
# =========================
model_test/*
!model_test/model_test.py

# =========================
# Keep trained YOLO model weights only
# =========================
!**/best.pt
!**/last.pt

# =========================
# Keep code folder (scoring_system + signboard_system, etc.)
# =========================
!code/**

# =========================
# Keep basic repo files
# =========================
!.gitignore
!README.md
