# ==========================================
# 專案專屬大型資產與影音忽略規則
# ==========================================

# 忽略所有輸入影片與其資料夾內的影片
video/*.mp4
video/*.avi
video/*.mov

# 忽略所有輸出的分析影片與臨時影片
output/*.mp4
output/*.avi

# 忽略 Whisper 產生的聽覺逐字稿快取與本地事件紀錄紀錄檔
output/speech_cache.json
output/event_record*.txt
output/transcript_with_events*.txt

# 忽略二進位執行檔（FFmpeg 執行檔由使用者本機自行配置）
*.exe
ffmpeg.exe

# ==========================================
# AI 深度學習核心權重檔案忽略規則 (防止超過 GitHub 體積限制)
# ==========================================

# 忽略根目錄與 model 核心目錄下的所有 YOLO 權重檔
*.pt
model/*.pt

# 忽略視線追蹤模組的所有大型權重與特徵點任務模型
model/gaze/*.pth.tar
model/gaze/*.pt
model/gaze/*.task

# 如果未來有其他權重格式，一併忽略
*.guff
*.onnx
*.weights

# ==========================================
# Python 系統與編譯臨時檔案忽略規則
# ==========================================
__pycache__/
*/__pycache__/
modules/__pycache__/
modules/gaze_estimation/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 編輯器與 IDE 本地環境設定忽略規則
# ==========================================
.vscode/
.idea/
*.swp
*.bak
.DS_Store
Thumbs.db

# ==========================================
# 虛擬環境忽略規則 (如果把 venv 裝在專案內)
# ==========================================
venv/
env/
.env

# 加上這幾行超級防禦
**/*.pth.tar
**/*.pt
**/*.task
**/*.mp4
**/*.mov